{
  "manifest_version": 4,
  "name": "pocket_piggy",
  "version": "1.2",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
"permissions": [
    "storage",
    "tabs",
    "activeTab"
]
}